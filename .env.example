# Public application URL used to build secure links sent through WhatsApp.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Preview only. Exact comma-separated HTTPS origins allowed for public WhatsApp callbacks.
# Keep Production domains out of this list; use the canonical stable Preview alias for pilots.
WHATSAPP_PREVIEW_ALLOWED_PUBLIC_ORIGINS=
OBRASAAS_INVITATION_REDIRECT_URL=http://localhost:3000/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dedicated signing secret for /api/webhooks/clerk. Rotate per Clerk instance.
CLERK_WEBHOOK_SIGNING_SECRET=
# Exact Clerk instance_id accepted by the webhook (for example ins_...).
CLERK_EXPECTED_INSTANCE_ID=
# Independent HMAC key for privacy-minimized webhook evidence. Never reuse the signing secret.
CLERK_WEBHOOK_EVIDENCE_SECRET=
# Versioned identifier for the active evidence key. Increment on every rotation.
CLERK_WEBHOOK_EVIDENCE_KEY_ID=clerk-webhook-evidence-v1
# Retain prior key ID/secret pairs only in the approved secret-manager keyring for the
# forensic retention period; do not expose that historical keyring to the application runtime.
# Comma-separated exact origins accepted in Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
OBRASAAS_INTERNAL_CLERK_ORG_ID=

# Dedicated Stripe sandbox or production account for ObraSaaS only.
# Fail-closed: only the exact value "true" enables creation of Checkout sessions.
# DO NOT enable until BillingCheckoutIntent is durable, checkout creation is idempotent and
# concurrency-safe, the versioned consent UI is implemented, and webhook reconciliation is proven.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Neon pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# At least 32 random bytes. Never reuse the Meta verify token here.
WEBVIEW_TOKEN_SECRET=replace-with-a-long-random-secret
# Dedicated HMAC key for persisted, single-use operational WhatsApp Flow sessions.
WHATSAPP_FLOW_TOKEN_SECRET=replace-with-a-different-long-random-secret
# Separate HMAC domain for pre-worker onboarding sessions. Never reuse the
# operational Flow key, a Meta token, or an encryption/fingerprint key.
WORKER_ONBOARDING_FLOW_TOKEN_SECRET=replace-with-an-independent-long-random-secret
# Versioned HMAC keyring for terminal payment-destination Flow submissions.
# Retire a key only after the database-clock retirement helper reports zero:
# every row remains replayable until expiresAt + 24h, and PROCESSING blocks
# retirement at any age. The 30-minute issuance TTL alone is not sufficient.
# Rotation order: deploy the new active key while retaining the old key, drain
# old instances/in-flight requests, run the DB gate, then remove the old key.
# Values must be independent random secrets of at least 32 bytes; never reuse a
# Flow token, Meta credential, KEK or fingerprint key.
WORKER_PAYMENT_FLOW_SESSION_HMAC_ACTIVE_KEY_ID=payment-flow-hmac-v1
WORKER_PAYMENT_FLOW_SESSION_HMAC_KEYRING_JSON={"payment-flow-hmac-v1":"replace-with-an-independent-long-random-secret"}
# Legacy single-key compatibility maps to key ID `legacy-v1`. If migrating it
# into the keyring, retain that exact ID and secret until the DB gate is zero.
# Prefer the versioned keyring above.
# WORKER_PAYMENT_FLOW_SESSION_SECRET=
INTERNAL_API_SECRET=replace-with-a-different-long-random-secret
# Bearer secret used only by the bounded webhook recovery endpoint.
CRON_SECRET=replace-with-an-independent-random-secret

# Supplier commitment reminders. Sending remains fail-closed until the required
# values are configured. Enable only after the domain and webhook are verified remotely.
SUPPLIER_REMINDER_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=ObraSaaS <operaciones@example.com>
RESEND_VERIFIED_FROM_DOMAIN=example.com
# Must be unique per Resend account + deployment environment (for example obrasaas-prod).
RESEND_IDEMPOTENCY_NAMESPACE=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# Optional during a controlled webhook-secret rotation window.
RESEND_WEBHOOK_SECRET_PREVIOUS=

# Meta WhatsApp Business Cloud API (Graph API v25 is current as of July 2026).
META_GRAPH_API_VERSION=v25.0
META_APP_SECRET=
META_VERIFY_TOKEN=
# Preview only. Exact comma-separated WABA_ID:PHONE_NUMBER_ID pairs issued by Meta for testing.
# Never add production customer assets here and never enable the pilot importer in Production.
WHATSAPP_PILOT_ALLOWED_ASSETS=
WHATSAPP_PILOT_IMPORT_ENABLED=false
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=
# Independent AES-256-GCM KEK registry for per-connection Flow RSA private keys.
# JSON example shape: {"flow-kek-v1":"BASE64_32_RANDOM_BYTES"}
# Keep old entries while their key records are being rewrapped.
WHATSAPP_FLOW_ENDPOINT_KEK_ID=flow-kek-v1
WHATSAPP_FLOW_ENDPOINT_KEK_REGISTRY_JSON=

# Independent rotating AES-256-GCM keys for worker identity and payment data.
# JSON example shape: {"worker-financial-kek-v1":"BASE64_32_RANDOM_BYTES"}
# Keep retired entries until every protected record has been rewrapped.
WORKER_FINANCIAL_KEK_ID=worker-financial-kek-v1
WORKER_FINANCIAL_KEK_REGISTRY_JSON=
# Independent rotating HMAC-SHA-256 keys for tenant-scoped duplicate detection.
# JSON example shape: {"worker-financial-fingerprint-v1":"BASE64_32_RANDOM_BYTES"}
# Persist the key ID with each fingerprint and use a controlled dual-fingerprint migration.
# Never reuse any encryption KEK in this registry.
WORKER_FINANCIAL_FINGERPRINT_KEY_ID=worker-financial-fingerprint-v1
WORKER_FINANCIAL_FINGERPRINT_KEY_REGISTRY_JSON=

# Dedicated HMAC key for PRO-05 privacy discovery commitments. Use 32-64
# random bytes encoded as base64url and never reuse financial, Flow, Meta or AI
# secrets. Rotation changes only future item commitments; idempotency stays
# stable. Archive retired keys outside runtime only if reviewed re-verification
# policy requires them.
PRIVACY_DISCOVERY_FINGERPRINT_KEY_ID=privacy-discovery-hmac-v1
PRIVACY_DISCOVERY_FINGERPRINT_SECRET=

# Optional legacy Twilio sandbox compatibility.
TWILIO_AUTH_TOKEN=

# Internal demonstration project defaults. Tenant scope always comes from Clerk.
OBRASAAS_PROJECT_SLUG=palermo
PROJECT_LATITUDE=-34.5886
PROJECT_LONGITUDE=-58.4302
PROJECT_GEOFENCE_METERS=100

# AI and private evidence storage. Vercel Blob is the default; Cloudinary remains an optional adapter.
OPENAI_API_KEY=
# Required for OpenAI visual dispatch: stable random secret of at least 32 bytes.
# Keep it independent from OPENAI_API_KEY so API-key rotation does not change user pseudonyms.
AI_SAFETY_IDENTIFIER_SECRET=
OPENAI_SUPERVISOR_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Current high-quality vision default. Pin a dated snapshot after the evaluation gate is established.
OPENAI_VISION_MODEL=gpt-5.6-sol
# Pilot is fail-closed to `high`; other values are rejected until pricing/reservation is re-versioned.
OPENAI_VISION_DETAIL=high
# Required, fail-closed daily limit per tenant in integer micro-USD (1 USD = 1000000).
# The limit is snapshotted on first use of each UTC day and cannot change mid-day.
AI_VISUAL_DAILY_BUDGET_MICROS=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional challengers. Importing an adapter is not enough: registry role + adapter ID must be explicitly enabled.
HF_TOKEN=
# Optional Hugging Face organization billed for governed inference calls.
HF_BILL_TO=
HF_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# Explicit public Inference Providers route; never use auto/fastest/cheapest/preferred in governed runs.
# featherless-ai is an external provider/subprocessor; revalidate routing and data terms before enabling.
HF_QWEN3_VL_PROVIDER=featherless-ai
# These adapters call Z.ai's public APIs and remain disabled until their contractual/data gate is complete.
ZAI_API_KEY=
ZAI_VISION_MODEL=glm-5v-turbo
# ObraSaaS chunks PDFs at 30 pages as an internal bound even when the provider supports larger documents.
ZAI_OCR_MODEL=glm-ocr
ZAI_TEXT_MODEL=glm-5.2
BLOB_READ_WRITE_TOKEN=
PRIVATE_MEDIA_PROVIDER=vercel-blob
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "node scripts/inspect-release-configuration.mjs && npm run build:vercel",
  "ignoreCommand": "node scripts/vercel-native-git-release.mjs",
  "crons": [
    { "path": "/api/cron/webhooks", "schedule": "* * * * *" },
    { "path": "/api/cron/protected-uploads", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/notifications", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/supplier-reminders", "schedule": "*/15 * * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/saas-recovery-20260917": true,
      "validation/*": false,
      "operations/*": false
    }
  }
}

  verificationEvidenceHash     String?                        @db.Char(64)
  verifiedAt                   DateTime?
  /// Legacy transitional platform-user actor; retained for expand/contract.
  verifiedById                 String?
  verifiedBy                   PlatformUser?                  @relation("WorkerPaymentDestinationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedByMembershipId       String?
  verifiedByMembership         TenantMembership?              @relation("WorkerPaymentVerifierMembership", fields: [organizationId, verifiedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "WorkerPayment_verifier_membership_fkey")
  activatedAt                  DateTime?
  activatedByMembershipId      String?
  activatedByMembership        TenantMembership?              @relation("WorkerPaymentActivatorMembership", fields: [organizationId, activatedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "WorkerPayment_activator_membership_fkey")

  personId                        String?
  person                          WorkerPerson?                    @relation(fields: [organizationId, personId], references: [organizationId, id], onDelete: Restrict)
  externalId                      String?
  /// Legacy transitional channel authority. New identities live in
  /// WorkerChannelIdentity; null is valid after the dual-read/backfill cutover.
  phone                           String?
  name                            String
  role                            String?
  active                          Boolean                          @default(true)
  metadata                        Json?
  attendances                     AttendanceEntry[]
  attendanceShifts                AttendanceShift[]

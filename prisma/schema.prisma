  supersedingDestinations      WorkerPaymentDestination[]     @relation("WorkerPaymentDestinationVersions")
  operationKey                 String                         @db.VarChar(190)
  requestFingerprint           String                         @db.Char(64)
  submissionSource             WorkerPaymentSubmissionSource?
  submittedAt                  DateTime?
  submittedByMembershipId      String?
  submittedByMembership        TenantMembership?              @relation("WorkerPaymentSubmitterMembership", fields: [organizationId, submittedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "WorkerPayment_submitter_membership_fkey")
  submittedByChannelIdentityId String?
  submittedByChannelIdentity   WorkerChannelIdentity?         @relation("WorkerPaymentSubmitterChannel", fields: [organizationId, personId, submittedByChannelIdentityId], references: [organizationId, personId, id], onDelete: Restrict, map: "WorkerPayment_submitter_channel_fkey")
  resolvedType                 WorkerPaymentDestinationType?
  resolvedEncryptedPayload     String?                        @db.Text
  resolvedFingerprint          String?                        @db.Char(64)
  resolvedFingerprintKeyId     String?                        @db.VarChar(100)
  resolvedWrappingKeyId        String?                        @db.VarChar(100)
  resolvedRecordVersion        Int?
  /// Canonical account identity is database-derived: direct CBU/CVU records use
  /// their submitted fingerprint; resolved aliases use the resolved fingerprint.
  /// Nullable only while an alias is unresolved. Database uniqueness applies
  /// within one fingerprint-key epoch; the service deduplicates across accepted
  /// key epochs under a tenant/person/purpose advisory lock.
  canonicalType                WorkerPaymentDestinationType?
  canonicalFingerprint         String?                        @db.Char(64)
  canonicalFingerprintKeyId    String?                        @db.VarChar(100)
  verificationProvider         String?                        @db.VarChar(64)

  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt

  @@unique([projectId, phone])
  @@unique([projectId, id], map: "Worker_projectId_id_key")
  @@unique([organizationId, personId, projectId, id], map: "Worker_org_person_project_id_key")

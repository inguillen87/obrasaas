  status                          WorkerChannelIdentityStatus @default(PENDING)
  encryptedAddressPayload         String                      @db.Text
  addressFingerprint              String                      @db.Char(64)
  addressFingerprintKeyId         String                      @db.VarChar(100)
  addressLastFour                 String                      @db.VarChar(4)
  wrappingKeyId                   String                      @db.VarChar(100)
  recordVersion                   Int                         @default(1)
  /// A database CHECK requires this provider-subject bundle for VERIFIED rows.
  /// Rollout installs it NOT VALID, preflights legacy rows, then validates it.
  encryptedProviderSubjectPayload String?                     @db.Text
  providerSubjectFingerprint      String?                     @db.Char(64)
  providerSubjectFingerprintKeyId String?                     @db.VarChar(100)

  schedule                    AttendanceSchedule              @relation(fields: [scheduleId, projectId], references: [id, projectId], onDelete: Cascade, map: "AttendanceScheduleVersion_schedule_scope_fkey")
  version                     Int
  effectiveFrom               DateTime                        @db.Date
  timezone                    String                          @db.VarChar(64)
  earlyCheckInMinutes         Int                             @default(120) @db.SmallInt
  lateToleranceMinutes        Int                             @default(10) @db.SmallInt
  latePolicy                  AttendanceLatePolicy            @default(FULL_FROM_SCHEDULE)
  noShowAfterMinutes          Int                             @default(30) @db.SmallInt
  pendingCloseAfterMinutes    Int                             @default(60) @db.SmallInt
  absenceFinalizeAfterMinutes Int                             @default(120) @db.SmallInt
  status                      AttendanceScheduleVersionStatus @default(PUBLISHED)
  configHash                  String                          @db.Char(64)
  idempotencyKey              String                          @unique(map: "AttendanceScheduleVersion_idempotency_key") @db.VarChar(190)
  requestFingerprint          String                          @db.Char(64)
  createdById                 String?
  createdBy                   PlatformUser?                   @relation("AttendanceScheduleVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt                 DateTime?
  days                        AttendanceScheduleDay[]
  assignments                 AttendanceScheduleAssignment[]
  expectationRevisions        AttendanceExpectationRevision[]
  createdAt                   DateTime                        @default(now())

  @@unique([id, projectId], map: "AttendanceScheduleVersion_id_project_key")
  @@unique([scheduleId, version], map: "AttendanceScheduleVersion_schedule_version_key")
  @@unique([scheduleId, effectiveFrom], map: "AttendanceScheduleVersion_schedule_effective_key")
  @@index([projectId, status, effectiveFrom], map: "AttendanceScheduleVersion_project_effective_idx")
}

model AttendanceScheduleDay {
  id                   String                          @id @default(cuid())
  projectId            String
  scheduleVersionId    String
  scheduleVersion      AttendanceScheduleVersion       @relation(fields: [scheduleVersionId, projectId], references: [id, projectId], onDelete: Cascade, map: "AttendanceScheduleDay_version_scope_fkey")
  isoWeekday           Int                             @db.SmallInt
  isWorkingDay         Boolean                         @default(true)
  startMinute          Int?                            @db.SmallInt
  endMinute            Int?                            @db.SmallInt
  endDayOffset         Int                             @default(0) @db.SmallInt
  expectedBreakMinutes Int                             @default(0) @db.SmallInt
  expectationRevisions AttendanceExpectationRevision[]

  @@unique([scheduleVersionId, isoWeekday], map: "AttendanceScheduleDay_version_weekday_key")
  @@unique([id, scheduleVersionId, projectId], map: "AttendanceScheduleDay_id_version_project_key")
}

model AttendanceScheduleAssignment {
  id                 String                    @id @default(cuid())
  projectId          String
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId           String
  worker             Worker                    @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade, map: "AttendanceScheduleAssignment_worker_scope_fkey")
  scheduleVersionId  String

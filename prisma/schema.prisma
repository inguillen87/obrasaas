model WorkerChannelIdentity {
  id                              String                      @id @default(cuid())
  organizationId                  String
  organization                    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId                        String
  person                          WorkerPerson                @relation(fields: [organizationId, personId], references: [organizationId, id], onDelete: Restrict)

  identityVerifiedByMembershipId String?
  identityVerifiedByMembership   TenantMembership?          @relation("WorkerIdentityVerifierMembership", fields: [organizationId, identityVerifiedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "WorkerPerson_verifier_membership_fkey")
  identityRejectedAt             DateTime?
  /// Legacy transitional platform-user actor; retained for expand/contract.
  identityRejectedById           String?
  identityRejectedBy             PlatformUser?              @relation("WorkerIdentityRejecter", fields: [identityRejectedById], references: [id], onDelete: SetNull)
  identityRejectedByMembershipId String?

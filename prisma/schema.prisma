  type                         WorkerPaymentDestinationType
  rail                         WorkerPaymentRail?
  currency                     String                         @default("ARS") @db.Char(3)
  encryptedPayload             String                         @db.Text
  fingerprint                  String                         @db.Char(64)
  fingerprintKeyId             String                         @db.VarChar(100)

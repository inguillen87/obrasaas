generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskType {
  TASK
  MILESTONE
}

enum TaskDependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum WorkTeamStatus {
  ACTIVE
  ARCHIVED
}

enum WorkTeamMemberRole {
  LEAD
  MEMBER
}

enum TaskAssignmentStatus {
  PLANNED
  ACTIVE
  ENDED
  CANCELLED
}

enum ProjectBlockerStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ProjectBlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DailyLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ProgressEvidenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
  READ
}

enum ExtraWorkStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ExtraWorkSessionStatus {
  OPEN
  CLOSED
  VOIDED
}

enum ReplanScenarioStatus {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
}

enum BudgetVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum BudgetEntryKind {
  COMMITMENT
  ACTUAL
  FORECAST
}

enum CashFundStatus {
  ACTIVE
  CLOSED
}

enum CashMovementKind {
  FUNDING
  EXPENSE
  REIMBURSEMENT
  ADJUSTMENT
}

enum CashMovementStatus {
  DRAFT
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
}

enum IncidentSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttendanceStatus {
  PRESENT
  OUTSIDE_GEOFENCE
  EXCUSED
  ABSENT
  PENDING_GEO
  EXPIRED
}

enum AttendanceEventType {
  CHECK_IN
  BREAK_START
  BREAK_END
  CHECK_OUT
}

enum AttendanceVerificationStatus {
  LEGACY
  PENDING
  VERIFIED
  REVIEW_REQUIRED
  NOT_REQUIRED
  EXPIRED
  VOIDED
}

enum AttendanceShiftStatus {
  OPEN
  PENDING_CLOSE
  CLOSED
  LEGACY_INCOMPLETE
  VOIDED
}

enum AttendanceShiftPhase {
  WORKING
  ON_BREAK
}

enum AttendanceScheduleStatus {
  ACTIVE
  ARCHIVED
}

enum AttendanceScheduleVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AttendanceLatePolicy {
  FULL_FROM_SCHEDULE
  EXCLUDE_GRACE
}

enum AttendanceExpectationKind {
  WORKING
  NON_WORKING
  EXCUSED
}

enum AttendanceExceptionAction {
  SET
  CANCEL
}

enum AttendanceExceptionType {
  EXCUSED_ABSENCE
  APPROVED_LEAVE
  NON_WORKING_DAY
  OFFSITE_WORK
}

enum AttendanceCorrectionDecisionKind {
  APPROVED
  REJECTED
}

enum AttendanceAlertType {
  NO_SHOW
  PENDING_CLOSE
}

enum AttendanceAlertTransition {
  OPENED
  ACKNOWLEDGED
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  INTERACTIVE
  SYSTEM
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum SystemRole {
  SUPERADMIN
  TENANT_USER
}

enum SubscriptionPlan {
  TRIAL
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum TenantRole {
  ADMIN
  DIRECTOR
  SITE_MANAGER
  FINANCE
  AUDITOR
}

enum WhatsAppConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

enum WhatsAppFlowEndpointKeyStatus {
  STAGED
  ACTIVE
  RETIRING
  REVOKED
}

enum WhatsAppFlowEndpointRequestStatus {
  PROCESSING
  SUCCEEDED
  REJECTED
  FAILED
}

enum CrmStage {
  NEW
  CONTACTED
  QUALIFIED
  DEMO
  PROPOSAL
  TRIAL
  WON
  LOST
}

enum OperationalProposalType {
  TASK_PROGRESS
  DELAY_REPORT
  CRITICAL_INCIDENT
}

enum OperationalProposalStatus {
  PENDING
  APPLIED
  REJECTED
  EXPIRED
  INVALIDATED
}

model Organization {
  id                     String                 @id @default(cuid())
  clerkOrganizationId    String?                @unique
  name                   String
  slug                   String                 @unique
  country                String                 @default("AR")
  timezone               String                 @default("America/Argentina/Buenos_Aires")
  subscriptionPlan       SubscriptionPlan       @default(TRIAL)
  subscriptionStatus     SubscriptionStatus     @default(TRIALING)
  trialEndsAt            DateTime?
  stripeCustomerId       String?                @unique
  stripeSubscriptionId   String?                @unique
  metadata               Json?
  projects               Project[]
  memberships            TenantMembership[]
  auditLogs              AuditLog[]
  notificationDeliveries NotificationDelivery[]
  crmAccount             CrmAccount?
  whatsappFlowSessions   WhatsAppFlowSession[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model CrmAccount {
  id                    String        @id @default(cuid())
  organizationId        String?       @unique
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name                  String
  contactName           String?
  email                 String?
  phone                 String?
  segment               String?
  source                String?
  stage                 CrmStage      @default(NEW)
  estimatedSeats        Int?
  estimatedMonthlyValue Decimal?      @db.Decimal(12, 2)
  nextFollowUpAt        DateTime?
  notes                 String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([stage, nextFollowUpAt])
  @@index([email])
}

model PlatformUser {
  id                                 String                         @id @default(cuid())
  clerkUserId                        String                         @unique
  primaryEmail                       String                         @unique
  fullName                           String?
  avatarUrl                          String?
  systemRole                         SystemRole                     @default(TENANT_USER)
  memberships                        TenantMembership[]
  auditLogs                          AuditLog[]
  conversationReadStates             ConversationReadState[]
  attendanceScheduleVersions         AttendanceScheduleVersion[]    @relation("AttendanceScheduleVersionCreator")
  attendanceScheduleAssignments      AttendanceScheduleAssignment[] @relation("AttendanceScheduleAssignmentCreator")
  endedAttendanceScheduleAssignments AttendanceScheduleAssignment[] @relation("AttendanceScheduleAssignmentEnder")
  attendanceExceptionRevisions       AttendanceExceptionRevision[]  @relation("AttendanceExceptionRevisionCreator")
  attendanceCorrectionRequests       AttendanceCorrectionRequest[]  @relation("AttendanceCorrectionPlatformRequester")
  attendanceCorrectionDecisions      AttendanceCorrectionDecision[] @relation("AttendanceCorrectionDecider")
  attendanceAlertEvents              AttendanceAlertEvent[]         @relation("AttendanceAlertActor")
  lastSeenAt                         DateTime                       @default(now())
  createdAt                          DateTime                       @default(now())
  updatedAt                          DateTime                       @updatedAt
  notificationDeliveries             NotificationDelivery[]
  cashMovementsFirstApproved         CashMovement[]                 @relation("CashMovementFirstApprover")
  cashMovementsSecondApproved        CashMovement[]                 @relation("CashMovementSecondApprover")
  notificationPreferences            NotificationPreference[]
  cashFunds                          CashFund[]

  @@index([systemRole, createdAt])
}

model TenantMembership {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  user               PlatformUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clerkRole          String              @default("org:member")
  tenantRole         TenantRole          @default(AUDITOR)
  status             MembershipStatus    @default(ACTIVE)
  projectMemberships ProjectMembership[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, tenantRole, status])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          PlatformUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Project {
  id                            String                         @id @default(cuid())
  organizationId                String
  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                          String
  slug                          String
  status                        ProjectStatus                  @default(ACTIVE)
  address                       String?
  latitude                      Decimal?                       @db.Decimal(10, 7)
  longitude                     Decimal?                       @db.Decimal(10, 7)
  geofenceMeters                Int                            @default(100)
  startsAt                      DateTime?
  endsAt                        DateTime?
  metadata                      Json?
  snapshot                      ProjectSnapshot?
  workers                       Worker[]
  tasks                         Task[]
  taskDependencies              TaskDependency[]
  workTeams                     WorkTeam[]
  taskAssignments               TaskAssignment[]
  projectBlockers               ProjectBlocker[]
  dailyLogs                     DailyLog[]
  progressEvidence              ProgressEvidence[]
  notificationDeliveries        NotificationDelivery[]
  extraWorkRequests             ExtraWorkRequest[]
  replanScenarios               ReplanScenario[]
  extraWorkSessions             ExtraWorkSession[]
  budgetVersions                BudgetVersion[]
  cashFunds                     CashFund[]
  incidents                     Incident[]
  attendances                   AttendanceEntry[]
  attendanceShifts              AttendanceShift[]
  attendanceSchedules           AttendanceSchedule[]
  attendanceScheduleVersions    AttendanceScheduleVersion[]
  attendanceScheduleAssignments AttendanceScheduleAssignment[]
  attendanceExpectations        AttendanceExpectation[]
  attendanceExceptions          AttendanceException[]
  attendanceCorrectionRequests  AttendanceCorrectionRequest[]
  attendanceAlertEvents         AttendanceAlertEvent[]
  conversations                 Conversation[]
  webhookEvents                 WebhookEvent[]
  flowSessions                  WhatsAppFlowSession[]
  proposals                     OperationalProposal[]
  whatsapp                      WhatsAppConnection?
  projectMemberships            ProjectMembership[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model ProjectMembership {
  id                 String           @id @default(cuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenantMembershipId String
  tenantMembership   TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)
  status             MembershipStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([projectId, tenantMembershipId])
  @@index([tenantMembershipId, status, projectId])
  @@index([projectId, status])
}

model WhatsAppConnection {
  id                              String                   @id @default(cuid())
  projectId                       String                   @unique
  project                         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phoneNumberId                   String                   @unique
  whatsappBusinessId              String?
  displayPhoneNumber              String?
  verifiedBusinessName            String?
  enabled                         Boolean                  @default(true)
  connectionStatus                WhatsAppConnectionStatus @default(PENDING)
  encryptedAccessToken            String?                  @db.Text
  encryptedPin                    String?                  @db.Text
  tokenLastFour                   String?
  embeddedSignupVersion           String                   @default("v4")
  connectedAt                     DateTime?
  lastVerifiedAt                  DateTime?
  lastError                       String?                  @db.Text
  metadata                        Json?
  flowProvisioningLeaseId         String?                  @db.Uuid
  flowProvisioningBlueprintKey    String?                  @db.VarChar(64)
  flowProvisioningLeaseAcquiredAt DateTime?
  flowProvisioningLeaseExpiresAt  DateTime?
  flowEndpoint                    WhatsAppFlowEndpoint?
  flowTemplates                   WhatsAppFlowTemplate[]
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt

  @@index([whatsappBusinessId])
}

model WhatsAppFlowTemplate {
  id                 String             @id @default(cuid())
  connectionId       String
  connection         WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  whatsappBusinessId String             @db.VarChar(40)
  blueprintKey       String             @db.VarChar(100)
  providerTemplateId String?            @unique(map: "WAFlowTemplate_provider_id_key") @db.VarChar(40)
  name               String             @db.VarChar(512)
  language           String             @db.VarChar(35)
  category           String             @db.VarChar(32)
  status             String             @db.VarChar(40)
  contentSha256      String             @db.Char(64)
  flowId             String             @db.VarChar(40)
  screenId           String             @db.VarChar(30)
  bodyText           String             @db.VarChar(1024)
  buttonText         String             @db.VarChar(25)
  rejectionReason    String?            @db.Text
  submittedAt        DateTime?
  lastSyncedAt       DateTime?
  statusChangedAt    DateTime?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([connectionId, name, language], map: "WAFlowTemplate_name_language_key")
  @@unique([connectionId, blueprintKey, language, contentSha256], map: "WAFlowTemplate_blueprint_hash_key")
  @@index([connectionId, blueprintKey, status], map: "WAFlowTemplate_blueprint_status_idx")
  @@index([whatsappBusinessId, providerTemplateId], map: "WAFlowTemplate_waba_provider_idx")
}

model WhatsAppFlowEndpoint {
  id           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String                        @unique
  connection   WhatsAppConnection            @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  enabled      Boolean                       @default(true)
  keys         WhatsAppFlowEndpointKey[]
  requests     WhatsAppFlowEndpointRequest[]
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
}

model WhatsAppFlowEndpointKey {
  id                  String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId          String                        @db.Uuid
  endpoint            WhatsAppFlowEndpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  version             Int
  status              WhatsAppFlowEndpointKeyStatus @default(STAGED)
  encryptedPrivateKey String                        @db.Text
  publicKeyPem        String                        @db.Text
  publicKeySha256     String                        @unique @db.Char(64)
  wrappingKeyId       String                        @db.VarChar(100)
  uploadedAt          DateTime?
  verifiedAt          DateTime?
  activatedAt         DateTime?
  retiringAt          DateTime?
  retireAfter         DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([endpointId, version])
  @@index([endpointId, status, version])
  @@index([status, retireAfter])
  @@index([wrappingKeyId, status])
}

model WhatsAppFlowEndpointRequest {
  id                 String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId         String                            @db.Uuid
  endpoint           WhatsAppFlowEndpoint              @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  flowSessionId      String?                           @db.Uuid
  flowSession        WhatsAppFlowSession?              @relation(fields: [flowSessionId], references: [id], onDelete: SetNull)
  requestSha256      String                            @db.Char(64)
  action             String                            @db.VarChar(32)
  screen             String?                           @db.VarChar(30)
  keyVersion         Int?
  status             WhatsAppFlowEndpointRequestStatus @default(PROCESSING)
  responseStatus     Int?
  responseCiphertext String?                           @db.Text
  failureCode        String?                           @db.VarChar(64)
  attempts           Int                               @default(1)
  leaseToken         String?                           @db.Uuid
  leaseExpiresAt     DateTime?
  completedAt        DateTime?
  expiresAt          DateTime
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@unique([endpointId, requestSha256])
  @@index([endpointId, createdAt])
  @@index([endpointId, status, createdAt])
  @@index([status, leaseExpiresAt, createdAt])
  @@index([flowSessionId, createdAt])
  @@index([expiresAt, status])
}

model ProjectSnapshot {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state     Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Worker {
  id                             String                         @id @default(cuid())
  projectId                      String
  project                        Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId                     String?
  phone                          String
  name                           String
  role                           String?
  active                         Boolean                        @default(true)
  metadata                       Json?
  attendances                    AttendanceEntry[]
  attendanceShifts               AttendanceShift[]
  attendanceScheduleAssignments  AttendanceScheduleAssignment[]
  attendanceExpectations         AttendanceExpectation[]
  attendanceExceptions           AttendanceException[]
  attendanceCorrectionRequests   AttendanceCorrectionRequest[]  @relation("AttendanceCorrectionSubject")
  requestedAttendanceCorrections AttendanceCorrectionRequest[]  @relation("AttendanceCorrectionWorkerRequester")
  attendanceAlertEvents          AttendanceAlertEvent[]
  proposedOperationalItems       OperationalProposal[]          @relation("OperationalProposalProposer")
  resolvedOperationalItems       OperationalProposal[]          @relation("OperationalProposalResolver")
  teamMemberships                WorkTeamMember[]
  taskAssignments                TaskAssignment[]
  ownedProjectBlockers           ProjectBlocker[]
  dailyLogs                      DailyLog[]
  progressEvidence               ProgressEvidence[]
  requestedExtraWork             ExtraWorkRequest[]             @relation("ExtraWorkRequester")
  extraWorkSessions              ExtraWorkSession[]
  whatsappFlowSessions           WhatsAppFlowSession[]
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt

  @@unique([projectId, phone])
  @@unique([projectId, id], map: "Worker_projectId_id_key")
  @@index([externalId])
}

model OperationalProposal {
  id                 String                    @id @default(cuid())
  projectId          String
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposedByWorkerId String?
  proposedByWorker   Worker?                   @relation("OperationalProposalProposer", fields: [proposedByWorkerId], references: [id], onDelete: SetNull)
  resolvedByWorkerId String?
  resolvedByWorker   Worker?                   @relation("OperationalProposalResolver", fields: [resolvedByWorkerId], references: [id], onDelete: SetNull)
  sourceProvider     String                    @db.VarChar(32)
  sourceExternalId   String                    @db.VarChar(512)
  resolverProvider   String?                   @db.VarChar(32)
  resolverExternalId String?                   @db.VarChar(512)
  confirmationCode   String                    @db.VarChar(16)
  type               OperationalProposalType
  status             OperationalProposalStatus @default(PENDING)
  summary            String                    @db.VarChar(280)
  action             Json
  precondition       Json?
  result             Json?
  classifierVersion  String                    @db.VarChar(64)
  transcriptSha256   String                    @db.Char(64)
  expiresAt          DateTime
  resolvedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([projectId, sourceProvider, sourceExternalId], map: "OperationalProposal_source_event_key")
  @@unique([projectId, resolverProvider, resolverExternalId], map: "OperationalProposal_resolver_event_key")
  @@unique([projectId, confirmationCode])
  @@index([projectId, status, expiresAt])
  @@index([projectId, status, createdAt])
  @@index([proposedByWorkerId, status, createdAt])
}

model Task {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId        String?
  code              String?            @db.VarChar(64)
  title             String
  description       String?
  type              TaskType           @default(TASK)
  status            TaskStatus         @default(BACKLOG)
  progress          Int                @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  assignee          String?
  revision          Int                @default(0)
  parentId          String?
  parent            Task?              @relation("TaskHierarchy", fields: [projectId, parentId], references: [projectId, id], onDelete: Restrict)
  children          Task[]             @relation("TaskHierarchy")
  predecessors      TaskDependency[]   @relation("TaskDependencySuccessor")
  successors        TaskDependency[]   @relation("TaskDependencyPredecessor")
  assignments       TaskAssignment[]
  blockers          ProjectBlocker[]
  dailyLogs         DailyLog[]
  progressEvidence  ProgressEvidence[]
  extraWorkRequests ExtraWorkRequest[]
  budgetLines       BudgetLine[]
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([projectId, externalId])
  @@unique([projectId, id])
  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([projectId, parentId])
}

model TaskDependency {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorId String
  predecessor   Task               @relation("TaskDependencyPredecessor", fields: [projectId, predecessorId], references: [projectId, id], onDelete: Cascade)
  successorId   String
  successor     Task               @relation("TaskDependencySuccessor", fields: [projectId, successorId], references: [projectId, id], onDelete: Cascade)
  type          TaskDependencyType @default(FINISH_TO_START)
  lagDays       Int                @default(0)
  createdAt     DateTime           @default(now())

  @@unique([projectId, predecessorId, successorId], map: "TaskDependency_project_predecessor_successor_key")
  @@index([projectId, successorId])
}

model WorkTeam {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String?          @db.VarChar(64)
  name        String           @db.VarChar(160)
  status      WorkTeamStatus   @default(ACTIVE)
  revision    Int              @default(0)
  members     WorkTeamMember[]
  assignments TaskAssignment[]
  blockers    ProjectBlocker[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([projectId, id])
  @@unique([projectId, code])
  @@index([projectId, status, name])
}

model WorkTeamMember {
  id        String             @id @default(cuid())
  projectId String
  teamId    String
  team      WorkTeam           @relation(fields: [projectId, teamId], references: [projectId, id], onDelete: Cascade)
  workerId  String
  worker    Worker             @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade)
  role      WorkTeamMemberRole @default(MEMBER)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  revision  Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([projectId, teamId, workerId, startsAt])
  @@index([projectId, workerId, endsAt])
  @@index([projectId, teamId, endsAt])
}

model TaskAssignment {
  id        String               @id @default(cuid())
  projectId String
  taskId    String
  task      Task                 @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)
  workerId  String?
  worker    Worker?              @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade)
  teamId    String?
  team      WorkTeam?            @relation(fields: [projectId, teamId], references: [projectId, id], onDelete: Cascade)
  status    TaskAssignmentStatus @default(PLANNED)
  startsAt  DateTime?
  endsAt    DateTime?
  revision  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  project   Project              @relation(fields: [projectId], references: [id])

  @@unique([projectId, id])
  @@index([projectId, taskId, status])
  @@index([projectId, workerId, status])
  @@index([projectId, teamId, status])
}

model ProjectBlocker {
  id            String                 @id @default(cuid())
  projectId     String
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?                  @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Restrict)
  ownerWorkerId String?
  ownerWorker   Worker?                @relation(fields: [projectId, ownerWorkerId], references: [projectId, id], onDelete: Restrict)
  ownerTeamId   String?

model Organization {
  id                              String                           @id @default(cuid())
  clerkOrganizationId             String?                          @unique
  name                            String
  slug                            String                           @unique
  country                         String                           @default("AR")
  timezone                        String                           @default("America/Argentina/Buenos_Aires")
  subscriptionPlan                SubscriptionPlan                 @default(TRIAL)
  subscriptionStatus              SubscriptionStatus               @default(TRIALING)
  trialEndsAt                     DateTime?
  stripeCustomerId                String?                          @unique
  stripeSubscriptionId            String?                          @unique
  metadata                        Json?
  projects                        Project[]
  memberships                     TenantMembership[]
  auditLogs                       AuditLog[]
  notificationDeliveries          NotificationDelivery[]
  crmAccount                      CrmAccount?
  whatsappFlowSessions            WhatsAppFlowSession[]
  workerOnboardingFlowSessions    WorkerOnboardingFlowSession[]
  progressEvidenceCaptureSessions ProgressEvidenceCaptureSession[]
  suppliers                       Supplier[]
  supplierInvoices                SupplierInvoice[]
  purchaseOrders                  PurchaseOrder[]
  goodsReceipts                   GoodsReceipt[]
  workerPersons                   WorkerPerson[]
  workerChannelIdentities         WorkerChannelIdentity[]
  workerOnboardingClaims          WorkerOnboardingClaim[]
  workerPaymentDestinations       WorkerPaymentDestination[]
  workerSensitiveDecisions        WorkerSensitiveDecision[]
  aiDailyBudgetLedgers            AiDailyBudgetLedger[]
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  workers                         Worker[]
}

model Supplier {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName      String            @db.VarChar(220)
  taxId          String?           @db.VarChar(64)
  email          String?           @db.VarChar(190)
  phone          String?           @db.VarChar(64)
  currency       String            @default("ARS") @db.Char(3)
  paymentTerms   String?           @db.VarChar(160)
  active         Boolean           @default(true)
  revision       Int               @default(0)
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, taxId])
  @@index([organizationId, active, legalName])
}

model SupplierInvoice {
  id                 String                @id @default(cuid())
  organizationId     String
  projectId          String
  supplierId         String
  purchaseOrderId    String?
  operationKey       String                @db.VarChar(190)
  invoiceNumber      String                @db.VarChar(96)
  currency           String                @db.Char(3)
  amount             Decimal               @db.Decimal(14, 2)
  status             SupplierInvoiceStatus @default(RECEIVED)
  dueAt              DateTime?
  receipt            Json?
  protectedUploadId  String?
  protectedUpload    ProtectedUpload?      @relation("SupplierInvoiceProtectedUpload", fields: [projectId, protectedUploadId], references: [projectId, id], onDelete: Restrict, map: "SupplierInvoice_protected_upload_fkey")
  requestFingerprint String?               @db.Char(64)
  revision           Int                   @default(0)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier           Supplier              @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([projectId, id])
  @@unique([projectId, operationKey])
  @@unique([projectId, protectedUploadId], map: "SupplierInvoice_project_protected_upload_key")
  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([projectId, status, dueAt])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  projectId      String
  supplierId     String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  operationKey   String              @db.VarChar(190)
  number         String              @db.VarChar(64)
  currency       String              @db.Char(3)
  status         PurchaseOrderStatus @default(DRAFT)
  total          Decimal             @db.Decimal(14, 2)
  revision       Int                 @default(0)
  lines          PurchaseOrderLine[]
  receipts       GoodsReceipt[]
  invoices       SupplierInvoice[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([projectId, id])
  @@unique([projectId, operationKey])
  @@unique([projectId, number])
  @@index([projectId, status, createdAt])
}

model PurchaseOrderLine {
  id              String             @id @default(cuid())
  purchaseOrderId String
  projectId       String
  budgetLineId    String?
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  budgetLine      BudgetLine?        @relation(fields: [projectId, budgetLineId], references: [projectId, id], onDelete: Restrict)
  receiptLines    GoodsReceiptLine[]
  description     String             @db.VarChar(220)
  unit            String             @db.VarChar(32)
  quantity        Decimal            @db.Decimal(14, 3)
  unitPrice       Decimal            @db.Decimal(14, 2)
  costCode        String?            @db.VarChar(96)
  createdAt       DateTime           @default(now())

  @@index([purchaseOrderId])
  @@index([projectId, budgetLineId])
}

model GoodsReceipt {
  id                 String             @id @default(cuid())
  projectId          String
  purchaseOrderId    String
  operationKey       String             @db.VarChar(190)
  status             GoodsReceiptStatus @default(POSTED)
  notes              String?            @db.VarChar(500)
  receipt            Json?
  protectedUploadId  String?
  protectedUpload    ProtectedUpload?   @relation("GoodsReceiptProtectedUpload", fields: [projectId, protectedUploadId], references: [projectId, id], onDelete: Restrict, map: "GoodsReceipt_protected_upload_fkey")
  requestFingerprint String?            @db.Char(64)
  receivedAt         DateTime           @default(now())
  revision           Int                @default(0)
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder      PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines              GoodsReceiptLine[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  organizationId     String?

  @@unique([projectId, id])
  @@unique([projectId, operationKey])
  @@unique([projectId, protectedUploadId], map: "GoodsReceipt_project_protected_upload_key")
  @@index([projectId, purchaseOrderId, receivedAt])
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  quantity            Decimal           @db.Decimal(14, 3)
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
}

model CrmAccount {
  id                    String        @id @default(cuid())
  organizationId        String?       @unique
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name                  String
  contactName           String?
  email                 String?
  phone                 String?
  segment               String?
  source                String?
  stage                 CrmStage      @default(NEW)
  estimatedSeats        Int?
  estimatedMonthlyValue Decimal?      @db.Decimal(12, 2)
  nextFollowUpAt        DateTime?
  notes                 String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([stage, nextFollowUpAt])
  @@index([email])
}

model PlatformUser {
  id                                 String                         @id @default(cuid())
  clerkUserId                        String                         @unique
  primaryEmail                       String                         @unique
  fullName                           String?
  avatarUrl                          String?
  systemRole                         SystemRole                     @default(TENANT_USER)
  memberships                        TenantMembership[]
  auditLogs                          AuditLog[]
  conversationReadStates             ConversationReadState[]
  attendanceScheduleVersions         AttendanceScheduleVersion[]    @relation("AttendanceScheduleVersionCreator")
  attendanceScheduleAssignments      AttendanceScheduleAssignment[] @relation("AttendanceScheduleAssignmentCreator")
  endedAttendanceScheduleAssignments AttendanceScheduleAssignment[] @relation("AttendanceScheduleAssignmentEnder")
  attendanceExceptionRevisions       AttendanceExceptionRevision[]  @relation("AttendanceExceptionRevisionCreator")
  attendanceCorrectionRequests       AttendanceCorrectionRequest[]  @relation("AttendanceCorrectionPlatformRequester")
  attendanceCorrectionDecisions      AttendanceCorrectionDecision[] @relation("AttendanceCorrectionDecider")
  attendanceAlertEvents              AttendanceAlertEvent[]         @relation("AttendanceAlertActor")
  lastSeenAt                         DateTime                       @default(now())
  createdAt                          DateTime                       @default(now())
  updatedAt                          DateTime                       @updatedAt
  notificationDeliveries             NotificationDelivery[]
  cashMovementsFirstApproved         CashMovement[]                 @relation("CashMovementFirstApprover")
  cashMovementsSecondApproved        CashMovement[]                 @relation("CashMovementSecondApprover")
  notificationPreferences            NotificationPreference[]
  cashFunds                          CashFund[]
  verifiedWorkerIdentities           WorkerPerson[]                 @relation("WorkerIdentityVerifier")
  rejectedWorkerIdentities           WorkerPerson[]                 @relation("WorkerIdentityRejecter")
  reviewedWorkerOnboardingClaims     WorkerOnboardingClaim[]        @relation("WorkerOnboardingReviewer")
  verifiedWorkerPaymentDestinations  WorkerPaymentDestination[]     @relation("WorkerPaymentDestinationVerifier")
  requestedVisualAssessments         VisualProgressAssessment[]     @relation("VisualProgressAssessmentRequester")
  reviewedVisualAssessments          VisualProgressAssessment[]     @relation("VisualProgressAssessmentReviewer")
  aiDispatchBudgetSettlements        AiDispatchBudgetReservation[]  @relation("AiDispatchBudgetSettlementActor")
  protectedUploads                   ProtectedUpload[]              @relation("ProtectedUploadActor")

  @@index([systemRole, createdAt])
}

model TenantMembership {
  id                                 String                     @id @default(cuid())
  organizationId                     String
  organization                       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                             String
  user                               PlatformUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  clerkRole                          String                     @default("org:member")
  tenantRole                         TenantRole                 @default(AUDITOR)
  status                             MembershipStatus           @default(ACTIVE)
  projectMemberships                 ProjectMembership[]
  verifiedWorkerIdentities           WorkerPerson[]             @relation("WorkerIdentityVerifierMembership")
  rejectedWorkerIdentities           WorkerPerson[]             @relation("WorkerIdentityRejecterMembership")
  reviewedWorkerOnboardingClaims     WorkerOnboardingClaim[]    @relation("WorkerOnboardingReviewerMembership")
  submittedWorkerPaymentDestinations WorkerPaymentDestination[] @relation("WorkerPaymentSubmitterMembership")
  verifiedWorkerPaymentDestinations  WorkerPaymentDestination[] @relation("WorkerPaymentVerifierMembership")
  activatedWorkerPaymentDestinations WorkerPaymentDestination[] @relation("WorkerPaymentActivatorMembership")
  rejectedWorkerPaymentDestinations  WorkerPaymentDestination[] @relation("WorkerPaymentRejecterMembership")
  revokedWorkerPaymentDestinations   WorkerPaymentDestination[] @relation("WorkerPaymentRevokerMembership")
  workerSensitiveDecisions           WorkerSensitiveDecision[]  @relation("WorkerSensitiveDecisionActor")
  createdAt                          DateTime                   @default(now())
  updatedAt                          DateTime                   @updatedAt

  @@unique([organizationId, userId])
  @@unique([organizationId, id], map: "TenantMembership_organizationId_id_key")
  @@index([userId, status])
  @@index([organizationId, tenantRole, status])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          PlatformUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Project {
  id                                   String                                @id @default(cuid())
  organizationId                       String
  organization                         Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                                 String
  slug                                 String
  status                               ProjectStatus                         @default(ACTIVE)
  address                              String?
  latitude                             Decimal?                              @db.Decimal(10, 7)
  longitude                            Decimal?                              @db.Decimal(10, 7)
  geofenceMeters                       Int                                   @default(100)
  startsAt                             DateTime?
  endsAt                               DateTime?
  metadata                             Json?
  snapshot                             ProjectSnapshot?
  workers                              Worker[]
  tenantScopedWorkers                  Worker[]                              @relation("WorkerTenantProject")
  tasks                                Task[]
  taskDependencies                     TaskDependency[]
  workTeams                            WorkTeam[]
  taskAssignments                      TaskAssignment[]
  projectBlockers                      ProjectBlocker[]
  dailyLogs                            DailyLog[]
  progressEvidence                     ProgressEvidence[]
  progressEvidenceCaptureSessions      ProgressEvidenceCaptureSession[]
  visualProgressAssessments            VisualProgressAssessment[]
  visualProgressProviderResultReceipts VisualProgressProviderResultReceipt[]
  aiDispatchBudgetReservations         AiDispatchBudgetReservation[]
  notificationDeliveries               NotificationDelivery[]
  extraWorkRequests                    ExtraWorkRequest[]
  replanScenarios                      ReplanScenario[]
  scheduleBaselines                    ScheduleBaseline[]
  scheduleForecastRuns                 ScheduleForecastRun[]
  extraWorkSessions                    ExtraWorkSession[]
  budgetVersions                       BudgetVersion[]
  cashFunds                            CashFund[]
  incidents                            Incident[]
  attendances                          AttendanceEntry[]
  attendanceShifts                     AttendanceShift[]
  attendanceSchedules                  AttendanceSchedule[]
  attendanceScheduleVersions           AttendanceScheduleVersion[]
  attendanceScheduleAssignments        AttendanceScheduleAssignment[]
  attendanceExpectations               AttendanceExpectation[]
  attendanceExceptions                 AttendanceException[]
  attendanceCorrectionRequests         AttendanceCorrectionRequest[]
  attendanceAlertEvents                AttendanceAlertEvent[]
  conversations                        Conversation[]
  webhookEvents                        WebhookEvent[]
  flowSessions                         WhatsAppFlowSession[]
  workerOnboardingFlowSessions         WorkerOnboardingFlowSession[]
  proposals                            OperationalProposal[]
  whatsapp                             WhatsAppConnection?
  projectMemberships                   ProjectMembership[]
  createdAt                            DateTime                              @default(now())
  updatedAt                            DateTime                              @updatedAt
  purchaseOrders                       PurchaseOrder[]
  goodsReceipts                        GoodsReceipt[]
  supplierInvoices                     SupplierInvoice[]
  workerDocuments                      WorkerDocument[]
  startActs                            ProjectStartAct[]
  workerOnboardingClaims               WorkerOnboardingClaim[]
  protectedUploads                     ProtectedUpload[]
  whatsappMediaAssets                  WhatsAppMediaAsset[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model ProtectedUpload {
  id                       String                 @id @default(cuid())
  organizationId           String
  projectId                String
  project                  Project                @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, map: "ProtectedUpload_project_scope_fkey")
  actorId                  String
  actor                    PlatformUser           @relation("ProtectedUploadActor", fields: [actorId], references: [id], onDelete: Restrict)
  purpose                  ProtectedUploadPurpose
  status                   ProtectedUploadStatus  @default(UPLOADING)
  operationKeyHash         String                 @db.Char(64)
  requestFingerprint       String                 @db.Char(64)
  storageProvider          String                 @db.VarChar(32)
  storage                  Json
  mimeType                 String                 @db.VarChar(120)
  filename                 String                 @db.VarChar(255)
  size                     Int
  sha256                   String                 @db.Char(64)
  expiresAt                DateTime
  uploadAttemptCount       Int                    @default(1)
  uploadLeaseExpiresAt     DateTime?
  claimedAt                DateTime?
  claimedEntityType        String?                @db.VarChar(64)
  claimedEntityId          String?                @db.VarChar(190)
  claimFingerprint         String?                @db.Char(64)
  deleteOperationKeyHash   String?                @db.Char(64)
  deleteRequestFingerprint String?                @db.Char(64)
  deleteRequestedAt        DateTime?
  deleteAttemptCount       Int                    @default(0)
  deleteLeaseExpiresAt     DateTime?
  nextDeleteAttemptAt      DateTime?
  deletedAt                DateTime?
  lastErrorCode            String?                @db.VarChar(64)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

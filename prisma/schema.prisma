  recordVersion                  Int                        @default(1)
  privacyNoticeVersion           String?                    @db.VarChar(64)
  privacyAcceptedAt              DateTime?
  identityVerifiedAt             DateTime?
  /// Legacy transitional platform-user actor. New decisions bind the tenant
  /// membership below so an actor cannot cross organization boundaries.

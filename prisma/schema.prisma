  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, personId, id], map: "WCI_org_person_id_key")
  @@unique([organizationId, provider, addressFingerprintKeyId, addressFingerprint], map: "WCI_org_provider_address_fp_key")
  @@unique([organizationId, provider, providerSubjectFingerprintKeyId, providerSubjectFingerprint], map: "WCI_org_provider_subject_fp_key")
  @@index([organizationId, personId, status])
}

model WorkerOnboardingClaim {
  id                              String                       @id @default(cuid())
  organizationId                  String
  organization                    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

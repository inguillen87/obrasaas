  effectiveFrom      DateTime                  @db.Date
  effectiveThrough   DateTime?                 @db.Date
  reasonCode         String?                   @db.VarChar(64)
  idempotencyKey     String                    @unique(map: "AttendanceScheduleAssignment_idempotency_key") @db.VarChar(190)
  requestFingerprint String                    @db.Char(64)
  createdById        String?
  createdBy          PlatformUser?             @relation("AttendanceScheduleAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

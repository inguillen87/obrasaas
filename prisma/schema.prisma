  @@index([organizationId, status, identityStatus])
  @@index([identityVerifiedById, identityVerifiedAt])
  @@index([identityVerifiedByMembershipId, identityVerifiedAt], map: "WorkerPerson_verifier_membership_idx")
  @@index([identityRejectedByMembershipId, identityRejectedAt], map: "WorkerPerson_rejecter_membership_idx")

  claimedIdentityEncryptedPayload String?                      @db.Text
  claimedCuilFingerprint          String?                      @db.Char(64)
  claimedCuilFingerprintKeyId     String?                      @db.VarChar(100)
  claimedCuilLastFour             String?                      @db.VarChar(4)
  claimedIdentityWrappingKeyId    String?                      @db.VarChar(100)
  claimedIdentityRecordVersion    Int?
  privacyNoticeVersion            String?                      @db.VarChar(64)
  privacyNoticeContentSha256      String?                      @db.Char(64)
  privacyAcceptedAt               DateTime?
  sensitiveDataPurgedAt           DateTime?
  status                          WorkerOnboardingClaimStatus  @default(PENDING)
  expiresAt                       DateTime
  submittedAt                     DateTime?
  reviewedAt                      DateTime?
  /// Legacy transitional platform-user actor; retained for expand/contract.
  reviewedById                    String?
  reviewedBy                      PlatformUser?                @relation("WorkerOnboardingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedByMembershipId          String?
  reviewedByMembership            TenantMembership?            @relation("WorkerOnboardingReviewerMembership", fields: [organizationId, reviewedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "WorkerClaim_reviewer_membership_fkey")
  reviewEvidenceHash              String?                      @db.Char(64)
  rejectionReason                 String?                      @db.VarChar(500)
  resolvedPersonId                String?
  resolvedPerson                  WorkerPerson?                @relation("WorkerOnboardingResultPerson", fields: [organizationId, resolvedPersonId], references: [organizationId, id], onDelete: Restrict)
  resolvedChannelIdentityId       String?
  resolvedChannelIdentity         WorkerChannelIdentity?       @relation("WorkerOnboardingResultChannel", fields: [organizationId, resolvedPersonId, resolvedChannelIdentityId], references: [organizationId, personId, id], onDelete: Restrict, map: "WorkerClaim_resolved_channel_scope_fkey")
  resolvedWorkerId                String?
  resolvedWorker                  Worker?                      @relation("WorkerOnboardingResultWorker", fields: [organizationId, resolvedPersonId, projectId, resolvedWorkerId], references: [organizationId, personId, projectId, id], onDelete: Restrict, map: "WorkerClaim_resolved_worker_scope_fkey")
  operationKey                    String                       @db.VarChar(190)
  requestFingerprint              String                       @db.Char(64)
  revision                        Int                          @default(0)
  sensitiveDecisions              WorkerSensitiveDecision[]    @relation("WorkerSensitiveDecisionOnboardingClaim")
  flowSession                     WorkerOnboardingFlowSession? @relation("WorkerOnboardingClaimFlowSession")
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, projectId, connectionId, id], map: "WorkerClaim_flow_session_scope_key")
  @@unique([connectionId, operationKey])
  @@index([organizationId, senderFingerprintKeyId, senderFingerprint, status], map: "WorkerClaim_org_sender_status_idx")
  @@index([projectId, status, expiresAt])
  @@index([resolvedPersonId, status])
  @@index([reviewedByMembershipId, reviewedAt], map: "WorkerClaim_reviewer_membership_idx")
}

model WorkerPaymentDestination {

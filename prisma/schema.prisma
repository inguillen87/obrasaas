/// Tenant/day aggregate used to reserve AI spend without summing request rows
/// under contention. Monetary values are integer micro-USD units; no floating
/// point value is admitted into the governed budget path.
model AiDailyBudgetLedger {
  organizationId     String
  organization       Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  civilDayUtc        DateTime                      @db.Date
  workload           String                        @db.VarChar(64)
  quotaPolicyVersion String                        @db.VarChar(64)
  budgetLimitMicros  BigInt
  reservedMicros     BigInt                        @default(0)
  settledMicros      BigInt                        @default(0)
  requestCount       BigInt                        @default(0)
  revision           Int                           @default(0)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  reservations       AiDispatchBudgetReservation[]

  @@id([organizationId, civilDayUtc, workload], map: "AiDailyBudgetLedger_pkey")
  @@index([civilDayUtc, workload], map: "AiDailyBudgetLedger_day_workload_idx")
  @@index([organizationId, updatedAt], map: "AiDailyBudgetLedger_org_updated_idx")
}

/// Idempotency and settlement identity for exactly one governed AI assessment.
/// The aggregate ledger is never decremented from caller-provided reservation
/// amounts; settlement consumes only this durable row's own reservation.
model AiDispatchBudgetReservation {
  assessmentId               String                            @id
  organizationId             String
  projectId                  String
  project                    Project                           @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, map: "AiDispatchBudgetReservation_project_scope_fkey")
  assessment                 VisualProgressAssessment          @relation(fields: [projectId, assessmentId], references: [projectId, id], onDelete: Cascade, map: "AiDispatchBudgetReservation_assessment_scope_fkey")
  civilDayUtc                DateTime                          @db.Date
  workload                   String                            @db.VarChar(64)
  quotaPolicyVersion         String                            @db.VarChar(64)
  budgetLimitMicros          BigInt
  reservedMicros             BigInt
  actualMicros               BigInt?
  status                     AiDispatchBudgetReservationStatus @default(RESERVED)
  settlementBasis            AiDispatchSettlementBasis?
  settlementOperationKeyHash String?                           @db.Char(64)
  settlementEvidenceSha256   String?                           @db.Char(64)
  settledById                String?
  settledBy                  PlatformUser?                     @relation("AiDispatchBudgetSettlementActor", fields: [settledById], references: [id], onDelete: Restrict)
  reservedAt                 DateTime                          @default(now())
  settledAt                  DateTime?
  revision                   Int                               @default(0)
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  dailyLedger                AiDailyBudgetLedger               @relation(fields: [organizationId, civilDayUtc, workload], references: [organizationId, civilDayUtc, workload], onDelete: NoAction, map: "AiDispatchBudgetReservation_daily_ledger_fkey")

  @@unique([projectId, assessmentId], map: "AiDispatchBudgetReservation_project_assessment_key")
  @@unique([organizationId, settlementOperationKeyHash], map: "AiDispatchBudgetReservation_org_settlement_operation_key")
  @@index([organizationId, civilDayUtc, workload, status], map: "AiDispatchBudgetReservation_ledger_status_idx")
  @@index([organizationId, status, updatedAt], map: "AiDispatchBudgetReservation_org_status_updated_idx")
  @@index([settledById, settledAt], map: "AiDispatchBudgetReservation_settled_by_idx")
}


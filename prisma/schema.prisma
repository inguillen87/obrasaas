  @@unique([projectId, workerId, effectiveFrom], map: "AttendanceScheduleAssignment_worker_from_key")
  @@index([projectId, effectiveFrom, effectiveThrough], map: "AttendanceScheduleAssignment_project_effective_idx")
  @@index([workerId, effectiveFrom, effectiveThrough], map: "AttendanceScheduleAssignment_worker_effective_idx")
}

model AttendanceExpectation {
  id                 String                          @id @default(cuid())
  projectId          String
  project            Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId           String
  worker             Worker                          @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade, map: "AttendanceExpectation_worker_scope_fkey")
  workDate           DateTime                        @db.Date
  revision           Int                             @default(0)
  revisions          AttendanceExpectationRevision[]
  shift              AttendanceShift?
  correctionRequests AttendanceCorrectionRequest[]
  alertEvents        AttendanceAlertEvent[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@unique([id, projectId, workerId], map: "AttendanceExpectation_id_project_worker_key")
  @@unique([id, projectId, workerId, workDate], map: "AttendanceExpectation_id_scope_date_key")
  @@unique([projectId, workerId, workDate], map: "AttendanceExpectation_worker_date_key")
  @@index([projectId, workDate], map: "AttendanceExpectation_project_date_idx")
}

model AttendanceExpectationRevision {
  id                   String                       @id @default(cuid())
  projectId            String
  workerId             String
  workDate             DateTime                     @db.Date
  expectationId        String
  expectation          AttendanceExpectation        @relation(fields: [expectationId, projectId, workerId, workDate], references: [id, projectId, workerId, workDate], onDelete: Cascade, map: "AttendanceExpectationRevision_expectation_scope_fkey")
  revision             Int
  kind                 AttendanceExpectationKind
  scheduleVersionId    String?
  scheduleVersion      AttendanceScheduleVersion?   @relation(fields: [scheduleVersionId, projectId], references: [id, projectId], onDelete: NoAction, map: "AttendanceExpectationRevision_version_scope_fkey")
  scheduleDayId        String?
  scheduleDay          AttendanceScheduleDay?       @relation(fields: [scheduleDayId, scheduleVersionId, projectId], references: [id, scheduleVersionId, projectId], onDelete: NoAction, map: "AttendanceExpectationRevision_day_scope_fkey")
  exceptionRevisionId  String?
  exceptionRevision    AttendanceExceptionRevision? @relation(fields: [exceptionRevisionId, projectId, workerId, workDate], references: [id, projectId, workerId, workDate], onDelete: NoAction, map: "AttendanceExpectationRevision_exception_scope_fkey")
  alertEvents          AttendanceAlertEvent[]
  timezone             String                       @db.VarChar(64)
  expectedStartAt      DateTime?
  expectedEndAt        DateTime?
  graceEndsAt          DateTime?
  noShowAt             DateTime?
  pendingCloseAt       DateTime?
  absenceAt            DateTime?
  latePolicy           AttendanceLatePolicy?
  expectedBreakMinutes Int?                         @db.SmallInt
  classifierVersion    String                       @db.VarChar(64)
  policyHash           String                       @db.Char(64)
  createdAt            DateTime                     @default(now())

  @@unique([expectationId, revision], map: "AttendanceExpectationRevision_expectation_revision_key")
  @@unique([id, expectationId, projectId, workerId], map: "AttendanceExpectationRevision_id_expectation_scope_key")
  @@index([noShowAt, id], map: "AttendanceExpectationRevision_no_show_idx")
  @@index([pendingCloseAt, id], map: "AttendanceExpectationRevision_pending_close_idx")
}

model AttendanceException {
  id          String                        @id @default(cuid())
  projectId   String
  project     Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker                        @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade, map: "AttendanceException_worker_scope_fkey")
  workDate    DateTime                      @db.Date
  revision    Int                           @default(0)
  active      Boolean                       @default(false)
  currentType AttendanceExceptionType?
  revisions   AttendanceExceptionRevision[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@unique([id, projectId, workerId], map: "AttendanceException_id_project_worker_key")
  @@unique([id, projectId, workerId, workDate], map: "AttendanceException_id_scope_date_key")
  @@unique([projectId, workerId, workDate], map: "AttendanceException_worker_date_key")
  @@index([projectId, workDate, active], map: "AttendanceException_project_date_idx")
}

model AttendanceExceptionRevision {
  id                   String                          @id @default(cuid())
  projectId            String
  workerId             String
  workDate             DateTime                        @db.Date
  exceptionId          String
  exception            AttendanceException             @relation(fields: [exceptionId, projectId, workerId, workDate], references: [id, projectId, workerId, workDate], onDelete: Cascade, map: "AttendanceExceptionRevision_exception_scope_fkey")
  revision             Int
  action               AttendanceExceptionAction
  type                 AttendanceExceptionType?
  reasonCode           String                          @db.VarChar(64)
  note                 String?                         @db.VarChar(280)
  idempotencyKey       String                          @unique(map: "AttendanceExceptionRevision_idempotency_key") @db.VarChar(190)
  requestFingerprint   String                          @db.Char(64)
  createdById          String?
  createdBy            PlatformUser?                   @relation("AttendanceExceptionRevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expectationRevisions AttendanceExpectationRevision[]
  createdAt            DateTime                        @default(now())

  @@unique([exceptionId, revision], map: "AttendanceExceptionRevision_exception_revision_key")
  @@unique([id, projectId, workerId, workDate], map: "AttendanceExceptionRevision_id_scope_date_key")
}

model AttendanceCorrectionRequest {
  id                        String                        @id @default(cuid())
  projectId                 String
  project                   Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId                  String
  worker                    Worker                        @relation("AttendanceCorrectionSubject", fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade, map: "AttendanceCorrectionRequest_worker_scope_fkey")
  expectationId             String?
  expectation               AttendanceExpectation?        @relation(fields: [expectationId, projectId, workerId], references: [id, projectId, workerId], onDelete: Restrict, map: "AttendanceCorrectionRequest_expectation_scope_fkey")
  shiftId                   String
  shift                     AttendanceShift               @relation(fields: [shiftId, projectId, workerId], references: [id, projectId, workerId], onDelete: Restrict, map: "AttendanceCorrectionRequest_shift_scope_fkey")
  targetEntryId             String?
  targetEntry               AttendanceEntry?              @relation(fields: [targetEntryId, projectId, workerId], references: [id, projectId, workerId], onDelete: Restrict, map: "AttendanceCorrectionRequest_entry_scope_fkey")
  baseShiftRevision         Int
  baseEffectiveHash         String                        @db.Char(64)
  proposedEvents            Json
  proposedEffectiveHash     String                        @db.Char(64)
  reasonCode                String                        @db.VarChar(64)
  note                      String?                       @db.VarChar(280)
  requestedByPlatformUserId String?
  requestedByPlatformUser   PlatformUser?                 @relation("AttendanceCorrectionPlatformRequester", fields: [requestedByPlatformUserId], references: [id], onDelete: Restrict)
  requestedByWorkerId       String?
  requestedByWorker         Worker?                       @relation("AttendanceCorrectionWorkerRequester", fields: [projectId, requestedByWorkerId], references: [projectId, id], onDelete: NoAction, map: "AttendanceCorrectionRequest_requester_scope_fkey")
  idempotencyKey            String                        @unique(map: "AttendanceCorrectionRequest_idempotency_key") @db.VarChar(190)
  requestFingerprint        String                        @db.Char(64)
  expiresAt                 DateTime
  decision                  AttendanceCorrectionDecision?
  adjustment                AttendanceAdjustment?
  createdAt                 DateTime                      @default(now())

  @@index([projectId, createdAt, id], map: "AttendanceCorrectionRequest_project_created_idx")
  @@index([shiftId, createdAt], map: "AttendanceCorrectionRequest_shift_created_idx")
}

model AttendanceCorrectionDecision {
  id                 String                           @id @default(cuid())
  requestId          String                           @unique(map: "AttendanceCorrectionDecision_request_key")
  request            AttendanceCorrectionRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  decision           AttendanceCorrectionDecisionKind
  reasonCode         String                           @db.VarChar(64)
  note               String?                          @db.VarChar(280)
  decidedById        String
  decidedBy          PlatformUser                     @relation("AttendanceCorrectionDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  idempotencyKey     String                           @unique(map: "AttendanceCorrectionDecision_idempotency_key") @db.VarChar(190)
  requestFingerprint String                           @db.Char(64)
  createdAt          DateTime                         @default(now())
}

model AttendanceAdjustment {
  id                   String                      @id @default(cuid())
  correctionRequestId  String                      @unique(map: "AttendanceAdjustment_request_key")
  correctionRequest    AttendanceCorrectionRequest @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)
  appliedShiftRevision Int
  baseLedgerSequence   Int
  baseEffectiveHash    String                      @db.Char(64)
  effectiveHash        String                      @db.Char(64)
  effectiveEvents      Json
  createdAt            DateTime                    @default(now())

  @@index([createdAt, id], map: "AttendanceAdjustment_created_idx")
}

model AttendanceAlertEvent {
  id                    String                        @id @default(cuid())
  projectId             String
  project               Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId              String
  worker                Worker                        @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade, map: "AttendanceAlertEvent_worker_scope_fkey")
  expectationId         String
  expectation           AttendanceExpectation         @relation(fields: [expectationId, projectId, workerId], references: [id, projectId, workerId], onDelete: Cascade, map: "AttendanceAlertEvent_expectation_scope_fkey")
  expectationRevisionId String
  expectationRevision   AttendanceExpectationRevision @relation(fields: [expectationRevisionId, expectationId, projectId, workerId], references: [id, expectationId, projectId, workerId], onDelete: NoAction, map: "AttendanceAlertEvent_revision_scope_fkey")
  shiftId               String?
  shift                 AttendanceShift?              @relation(fields: [shiftId, projectId, workerId], references: [id, projectId, workerId], onDelete: NoAction, map: "AttendanceAlertEvent_shift_scope_fkey")
  type                  AttendanceAlertType
  transition            AttendanceAlertTransition
  dedupeKey             String                        @unique(map: "AttendanceAlertEvent_dedupe_key") @db.VarChar(190)
  causationId           String?                       @db.VarChar(190)
  classifierVersion     String                        @db.VarChar(64)
  payload               Json?
  actorId               String?
  actor                 PlatformUser?                 @relation("AttendanceAlertActor", fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt            DateTime                      @default(now())
  createdAt             DateTime                      @default(now())

  @@index([projectId, occurredAt, id], map: "AttendanceAlertEvent_project_occurred_idx")
  @@index([expectationId, type, occurredAt], map: "AttendanceAlertEvent_expectation_type_idx")
}

model Conversation {
  id                      String                  @id @default(cuid())
  projectId               String
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel                 String                  @default("whatsapp")
  externalId              String
  displayName             String?
  metadata                Json?
  messages                Message[]
  whatsappMediaAssets     WhatsAppMediaAsset[]    @relation("WhatsAppMediaAssetConversation")
  progressEvidenceSources ProgressEvidence[]      @relation("ProgressEvidenceSourceConversation")
  readStates              ConversationReadState[]
  unreadTrackingStartedAt DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([projectId, channel, externalId])
  @@unique([projectId, id], map: "Conversation_projectId_id_key")
  @@index([projectId, channel, updatedAt, id])
}

model ConversationReadState {
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  platformUserId    String
  platformUser      PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  lastReadMessageId String
  lastReadCreatedAt DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@id([conversationId, platformUserId])
  @@index([platformUserId, updatedAt])
}

model Message {
  id                     String              @id @default(cuid())
  conversationId         String
  conversation           Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId             String?             @unique
  providerMessageId      String?             @unique
  direction              MessageDirection
  kind                   MessageKind         @default(TEXT)
  body                   String?
  mediaUrl               String?
  status                 String?
  metadata               Json?
  progressEvidenceSource ProgressEvidence?   @relation("ProgressEvidenceSourceMessage")
  whatsappMediaAsset     WhatsAppMediaAsset? @relation("WhatsAppMediaAssetMessage")
  sentAt                 DateTime            @default(now())
  createdAt              DateTime            @default(now())

  @@unique([conversationId, id], map: "Message_conversationId_id_key")
  @@index([conversationId, sentAt])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, direction, createdAt, id])
}

model WebhookEvent {
  id             String               @id @default(cuid())
  projectId      String?
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider       String
  externalId     String
  eventType      String
  status         WebhookStatus        @default(PENDING)
  attempts       Int                  @default(0)
  payload        Json
  lastError      String?
  nextAttemptAt  DateTime?            @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  appliedAt      DateTime?
  outcome        Json?
  processedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  mediaAssets    WhatsAppMediaAsset[]

  @@unique([provider, externalId])
  @@unique([projectId, id], map: "WebhookEvent_projectId_id_key")
  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, status, nextAttemptAt, createdAt])
  @@index([projectId, status, leaseExpiresAt, createdAt])
}

model WhatsAppFlowSession {
  id                  String                        @id @db.Uuid
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId            String
  worker              Worker                        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  phoneNumberId       String                        @db.VarChar(40)
  recipientPhone      String                        @db.VarChar(20)
  blueprintKey        String                        @db.VarChar(100)
  flowId              String                        @db.VarChar(40)
  screenId            String                        @db.VarChar(30)
  flowType            String                        @db.VarChar(64)
  sourceExternalId    String                        @db.VarChar(512)
  tokenSha256         String                        @unique @db.Char(64)
  expiresAt           DateTime
  deliveryAttemptedAt DateTime?
  deliveryRejectedAt  DateTime?
  sentAt              DateTime?
  providerMessageId   String?                       @unique @db.VarChar(500)
  consumedAt          DateTime?
  consumedExternalId  String?                       @db.VarChar(512)
  endpointRequests    WhatsAppFlowEndpointRequest[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([projectId, sourceExternalId, blueprintKey])
  @@unique([projectId, consumedExternalId])
  @@index([organizationId, expiresAt])
  @@index([projectId, workerId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@index([phoneNumberId, recipientPhone])
}

model WorkerOnboardingFlowSession {
  id                  String                        @id @db.Uuid
  claimId             String                        @unique
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project                       @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, map: "WorkerOnboardingFlowSession_project_scope_fkey")
  connectionId        String
  connection          WhatsAppConnection            @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Cascade, map: "WorkerOnboardingFlowSession_connection_scope_fkey")
  claim               WorkerOnboardingClaim         @relation("WorkerOnboardingClaimFlowSession", fields: [organizationId, projectId, connectionId, claimId], references: [organizationId, projectId, connectionId, id], onDelete: Cascade, map: "WorkerOnboardingFlowSession_claim_scope_fkey")
  phoneNumberId       String                        @db.VarChar(40)
  blueprintKey        String                        @db.VarChar(100)
  flowId              String                        @db.VarChar(40)
  screenId            String                        @db.VarChar(30)
  flowType            String                        @db.VarChar(64)
  sourceExternalId    String                        @db.VarChar(512)
  noticeVersion       String                        @db.VarChar(64)
  noticeContentSha256 String                        @db.Char(64)
  tokenSha256         String                        @unique @db.Char(64)
  expiresAt           DateTime
  deliveryAttemptedAt DateTime?
  deliveryRejectedAt  DateTime?
  sentAt              DateTime?
  providerMessageId   String?                       @unique @db.VarChar(500)
  /// Server-side evidence that INIT served the pinned notice; not proof that a person read it.
  privacyPresentedAt  DateTime?
  submittedAt         DateTime?
  consumedAt          DateTime?
  consumedExternalId  String?                       @db.VarChar(512)
  endpointRequests    WhatsAppFlowEndpointRequest[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([organizationId, projectId, connectionId, claimId], map: "WorkerOnboardingFlowSession_claim_scope_key")
  @@unique([projectId, sourceExternalId, blueprintKey], map: "WorkerOnboardingFlowSession_source_key")
  @@unique([projectId, consumedExternalId], map: "WorkerOnboardingFlowSession_consumed_event_key")
  @@index([organizationId, expiresAt])
  @@index([projectId, claimId, expiresAt])
  @@index([connectionId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@index([phoneNumberId, expiresAt])
}
